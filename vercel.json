{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self'; media-src 'self'; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/popup",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/popup/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "www.lannee.de" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "rewrites": [
    { "source": "/popup/karte/", "destination": "/karte/index.html" }
  ],
  "redirects": [
    { "source": "/draft", "destination": "/popup", "permanent": true },
    { "source": "/draft/", "destination": "/popup", "permanent": true },
    { "source": "/draft/:path*", "destination": "/popup/:path*", "permanent": true },
    { "source": "/popup/karte", "destination": "/popup/karte/", "permanent": true },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "1898.ma" }], "destination": "https://www.lannee.de/", "permanent": false },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.1898.ma" }], "destination": "https://www.lannee.de/", "permanent": false },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "garage.ma" }], "destination": "https://www.lannee.de/", "permanent": false },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.garage.ma" }], "destination": "https://www.lannee.de/", "permanent": false },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "kiosque.ma" }], "destination": "https://www.lannee.de/", "permanent": false },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.kiosque.ma" }], "destination": "https://www.lannee.de/", "permanent": false },

    { "source": "/impressum", "destination": "/#impressum", "permanent": true },
    { "source": "/impressum/", "destination": "/#impressum", "permanent": true },
    { "source": "/datenschutz", "destination": "/#datenschutz", "permanent": true },
    { "source": "/datenschutz/", "destination": "/#datenschutz", "permanent": true },
    { "source": "/:page(legal_notice|mentions-legales)", "destination": "/#impressum", "permanent": true },
    { "source": "/:page(legal_notice|mentions-legales)/", "destination": "/#impressum", "permanent": true },
    { "source": "/fr/mentions-legales", "destination": "/#impressum", "permanent": true },
    { "source": "/fr/mentions-legales/", "destination": "/#impressum", "permanent": true },
    { "source": "/en/legal-notice", "destination": "/#impressum", "permanent": true },
    { "source": "/en/legal-notice/", "destination": "/#impressum", "permanent": true },
    { "source": "/fr/confidentialite", "destination": "/#datenschutz", "permanent": true },
    { "source": "/fr/confidentialite/", "destination": "/#datenschutz", "permanent": true },
    { "source": "/en/privacy", "destination": "/#datenschutz", "permanent": true },
    { "source": "/en/privacy/", "destination": "/#datenschutz", "permanent": true },
    { "source": "/:page(garage|kiosque|marche)", "destination": "/", "permanent": true },
    { "source": "/:page(garage|kiosque|marche)/", "destination": "/", "permanent": true },
    { "source": "/:page(atlanten|austernatlas|kontakt|styleguide|das-jahr)", "destination": "/", "permanent": true },
    { "source": "/:page(atlanten|austernatlas|kontakt|styleguide|das-jahr)/", "destination": "/", "permanent": true },
    { "source": "/fr", "destination": "/", "permanent": true },
    { "source": "/fr/(.*)", "destination": "/", "permanent": true },
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/en/(.*)", "destination": "/", "permanent": true }
  ]
}
