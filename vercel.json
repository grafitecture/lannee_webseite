{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node src/build.mjs",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; font-src 'self'; connect-src 'self'; manifest-src 'self'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/(.*)",
      "missing": [{ "type": "host", "value": "1898.ma" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "garage.ma" }], "destination": "https://1898.ma/", "permanent": false },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.garage.ma" }], "destination": "https://1898.ma/", "permanent": false },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "kiosque.ma" }], "destination": "https://1898.ma/", "permanent": false },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.kiosque.ma" }], "destination": "https://1898.ma/", "permanent": false },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "www.1898.ma" }], "destination": "https://1898.ma/$1", "permanent": true },

    { "source": "/fr/mentions-legales", "destination": "/impressum/", "permanent": true },
    { "source": "/fr/mentions-legales/", "destination": "/impressum/", "permanent": true },
    { "source": "/en/legal-notice", "destination": "/impressum/", "permanent": true },
    { "source": "/en/legal-notice/", "destination": "/impressum/", "permanent": true },
    { "source": "/fr/confidentialite", "destination": "/datenschutz/", "permanent": true },
    { "source": "/fr/confidentialite/", "destination": "/datenschutz/", "permanent": true },
    { "source": "/en/privacy", "destination": "/datenschutz/", "permanent": true },
    { "source": "/en/privacy/", "destination": "/datenschutz/", "permanent": true },
    { "source": "/fr", "destination": "/", "permanent": true },
    { "source": "/fr/:path*", "destination": "/", "permanent": true },
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/en/:path*", "destination": "/", "permanent": true },

    { "source": "/karte", "destination": "/#karte", "permanent": true },
    { "source": "/karte/", "destination": "/#karte", "permanent": true },
    { "source": "/:page(garage|kiosque|marche|atlanten|austernatlas|kontakt|styleguide|das-jahr)", "destination": "/", "permanent": true },
    { "source": "/:page(garage|kiosque|marche|atlanten|austernatlas|kontakt|styleguide|das-jahr)/", "destination": "/", "permanent": true },

    { "source": "/legal_notice", "destination": "/impressum/", "permanent": true },
    { "source": "/legal_notice/", "destination": "/impressum/", "permanent": true },
    { "source": "/mentions-legales", "destination": "/datenschutz/", "permanent": true },
    { "source": "/mentions-legales/", "destination": "/datenschutz/", "permanent": true }
  ]
}
